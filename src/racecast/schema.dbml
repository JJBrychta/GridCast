// RaceCast — normalized SQLite schema (build step output).
// Paste into https://dbdiagram.io to view.
//
// Data source per column:
//   [raw]     verbatim from a raw/ JSON field
//   [derived] computed by build.py from raw fields
//   [ergast]  from raw/<season>/circuits.json (Ergast get_race_schedule)
//   [todo]    NOT in raw yet — needs an extra fetch, left out for now
//
// The DB is a faithful, rebuildable mirror of raw/ — no aggregation, no
// training-window filter. That happens later in the feature step.

Enum session_type {
  fp1
  fp2
  fp3
  qualifying
  sprint_qualifying   // "Sprint Qualifying" / "Sprint Shootout"
  sprint
  race
}

Enum event_format {
  conventional
  sprint
  sprint_shootout
  testing
}


Table seasons {
  season_id  int  [pk, increment]
  year       int  [not null, unique, note: '[raw] folder / meta.season']
}


Table circuits {
  circuit_id   int      [pk, increment]
  circuit_ref  varchar  [not null, unique, note: '[ergast] circuitId slug: "monza", "spa"']
  name         varchar  [not null, note: '[ergast] circuitName']
  locality     varchar  [note: '[ergast]']
  country      varchar  [note: '[ergast]']
  lat          float    [note: '[ergast]']
  long         float    [note: '[ergast]']
}


Table events {
  event_id       int           [pk, increment]
  season_id      int           [not null, ref: > seasons.season_id]
  round_number   int           [not null, note: '[raw] schedule.RoundNumber']
  circuit_id     int           [not null, ref: > circuits.circuit_id, note: 'matched by round via circuits.json']
  event_name     varchar       [not null, note: '[raw] schedule.EventName']
  official_name  varchar       [note: '[raw] schedule.OfficialEventName']
  event_format   event_format  [note: '[raw] schedule.EventFormat']
  event_date     date          [note: '[raw] schedule.EventDate']
  country        varchar       [note: '[raw] schedule.Country']
  location       varchar       [note: '[raw] schedule.Location — host town, not the circuit']

  indexes {
    (season_id, round_number) [unique]
  }
}


// One row per real session slot in schedule.json (Session1..5, skipping None),
// name mapped through SESSION_NAME_TO_TYPE. Exists even for sessions we have no
// results for yet (FP1..3, sprint) so adding them later is just a new results
// table, no backfill of this one.
Table sessions {
  session_id     int           [pk, increment]
  event_id       int           [not null, ref: > events.event_id]
  session_type   session_type  [not null, note: '[derived] SessionN name -> slug']
  session_date   timestamp     [note: '[raw] schedule.SessionNDateUtc']

  indexes {
    (event_id, session_type) [unique]
  }
}


Table constructors {
  constructor_id  int      [pk, increment]
  team_ref        varchar  [not null, unique, note: '[raw] results.TeamId slug: "red_bull"']
  name            varchar  [not null, note: '[raw] results.TeamName']
  // nationality  varchar  [todo] Ergast get_constructor_info()
}


Table drivers {
  driver_id     int      [pk, increment]
  driver_ref    varchar  [not null, unique, note: '[raw] results.DriverId slug: "max_verstappen"']
  first_name    varchar  [note: '[raw] results.FirstName']
  last_name     varchar  [note: '[raw] results.LastName']
  abbreviation  varchar  [note: '[raw] results.Abbreviation — empty for pre-~1980 drivers']
  country_code  varchar  [note: '[raw] results.CountryCode — e.g. NED, empty for old drivers']
  // nationality varchar [todo] Ergast get_driver_info() — full "Dutch"
}


Table race_results {
  result_id            int      [pk, increment]
  session_id           int      [not null, ref: > sessions.session_id]
  driver_id            int      [not null, ref: > drivers.driver_id]
  constructor_id       int      [not null, ref: > constructors.constructor_id]
  driver_number        int      [note: '[raw] results.DriverNumber — the number raced that weekend']
  position             int      [note: '[raw] results.Position — finishing order, null for DNS']
  classified_position  varchar  [note: '[raw] results.ClassifiedPosition — "1".."20" / R / D / W / N']
  grid_position        int      [note: '[raw] results.GridPosition']
  status               varchar  [note: '[raw] results.Status — Finished / Lapped / Retired / Accident / Disqualified / Did not start']
  dnf                  boolean  [note: '[derived] classified_position is not a plain integer']
  points               float    [note: '[raw] results.Points']
  laps                 int      [note: '[raw] results.Laps — laps completed']
  time_ms              int      [note: '[raw] results.Time — race time / gap to leader, ms']
  // fastest_lap_rank  int      [todo] not in session.results; needs Ergast get_race_results()

  indexes {
    (session_id, driver_id) [unique]
  }
}


Table qualifying_results {
  result_id       int      [pk, increment]
  session_id      int      [not null, ref: > sessions.session_id]
  driver_id       int      [not null, ref: > drivers.driver_id]
  constructor_id  int      [not null, ref: > constructors.constructor_id]
  driver_number   int      [note: '[raw] results.DriverNumber']
  position        int      [note: '[raw] results.Position — final quali classification']
  q1_ms           int      [note: '[raw] results.Q1 — best Q1 lap, ms']
  q2_ms           int      [note: '[raw] results.Q2 — null if knocked out in Q1']
  q3_ms           int      [note: '[raw] results.Q3 — null if knocked out in Q2']

  indexes {
    (session_id, driver_id) [unique]
  }
}


// 2018+ only (F1 live-timing API). Aggregated by build.py from the per-minute
// session.weather_data timeseries stored in the raw file. No row for pre-2018
// sessions -> feature step LEFT JOINs, old races get NULL weather.
Table session_weather {
  session_id      int      [pk, ref: - sessions.session_id]
  air_temp_min    float
  air_temp_avg    float
  air_temp_max    float
  track_temp_min  float
  track_temp_avg  float
  track_temp_max  float
  humidity_avg    float
  pressure_avg    float
  wind_speed_avg  float
  wind_speed_max  float
  rainfall_any    boolean  [note: '[derived] did Rainfall flag true at any point']
  rainfall_pct    float    [note: '[derived] 0-100, share of the session with rain flagged']
}


// Build checkpoint — which raw files (at which hash) are already loaded.
// Lives in this DB on purpose: drop the DB, lose the ledger, full rebuild.
Table ingested_files {
  raw_path      varchar    [pk]
  content_hash  varchar    [not null]
  ingested_at   timestamp  [not null]
}
